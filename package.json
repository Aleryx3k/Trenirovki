{
  "name": "workout-app",
  "version": "1.7.0",
  "private": true,
  "description": "Офлайн дневник тренировок",
  "scripts": {
    "bundle:single": "node scripts/bundle-single.js",
    "build": "npm run bundle:single",
    "test": "node -e \"const fs=require('fs'); if(fs.existsSync('tests/run-all.js')){require('child_process').execSync('node tests/run-all.js',{stdio:'inherit'})}else{require('child_process').execSync('node --test',{stdio:'inherit'})}\"",
    "test:unit": "node --test",
    "test:e2e": "node tests/run-all.js",
    "cap:sync": "cap sync android",
    "cap:build": "cap build android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.4",
    "@capacitor/core": "^5.7.4",
    "@capacitor/filesystem": "^5.2.1",
    "@capacitor/haptics": "^5.0.7",
    "@capacitor/local-notifications": "^5.0.7",
    "@capacitor/share": "^5.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.4"
  }
}
